# Cursor Cloud Agents (Pro+ / usage limits apply — see Cursor dashboard)
CURSOR_API_KEY=

# GitHub repo Cursor can read/write (push template/ there first — see README)
TEMPLATE_REPO_URL=https://github.com/Alirezaanorouzi/builder-clinic-template

# Branch the agent commits to (connect this repo to Vercel)
TEMPLATE_REPO_REF=main

# Vercel — platform token for provisioning + deployment polling
# Create token: https://vercel.com/account/tokens
VERCEL_TOKEN=
# Legacy single-project dev id (optional; multi-tenant uses per-site projects)
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_PRODUCTION_URL=

# Optional model id from GET https://api.cursor.com/v1/models
CURSOR_MODEL_ID=

# Phase 3 provisioning — create per-site GitHub repos from template (repo scope on token)
PLATFORM_GITHUB_TOKEN=
GITHUB_REPO_OWNER=

# Local MVP: SQLite file (no Docker DB required)
DATABASE_URL="file:./dev.db"
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Local dev: process queued builds inside Next.js (or run `npm run worker` in another terminal)
INLINE_BUILD_WORKER=1
