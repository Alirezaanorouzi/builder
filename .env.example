# Local / Liara Postgres — see Liara dashboard for host, user, password, db name
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Cursor Cloud Agents (Pro+ / usage limits apply — see Cursor dashboard)
# direct = call api.cursor.com with CURSOR_API_KEY (local dev or allowed egress)
# gateway = call Vercel proxy only; set ENGINE_* and omit CURSOR_API_KEY on blocked regions (e.g. Liara)
# If CURSOR_TRANSPORT is unset: when ENGINE_GATEWAY_URL + ENGINE_GATEWAY_TOKEN are set and CURSOR_API_KEY is empty, gateway is used.
# CURSOR_TRANSPORT=direct
CURSOR_API_KEY=

# For gateway — deploy `gateway/` to Vercel (see gateway/README.md)
# ENGINE_GATEWAY_URL=https://your-gateway.vercel.app
# ENGINE_GATEWAY_TOKEN=          # Cursor proxy (builder → gateway)
# ENGINE_GATEWAY_TOKEN_VERCEL=   # optional separate token for GET /api/vercel/v6/deployments
# VERCEL_DEPLOYMENTS_TRANSPORT=gateway   # default when ENGINE_GATEWAY_URL + token set; use direct to bypass

# GitHub repo Cursor can read/write (push template/ there first — see README)
TEMPLATE_REPO_URL=https://github.com/Alirezaanorouzi/builder-clinic-template
TEMPLATE_REPO_REF=main

# Vercel — Liara: provisioning + direct poll fallback (deploy list polls prefer gateway when configured)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PRODUCTION_URL=

# Cloud Agent model (default composer-2.5 standard — API bills fast unless fast=false; we send that automatically)
# CURSOR_MODEL_ID=composer-2.5
# CURSOR_COMPOSER_FAST=1

# Per-site GitHub repos from template (repo scope on token)
PLATFORM_GITHUB_TOKEN=
GITHUB_REPO_OWNER=

# Comma-separated emails promoted to admin on login (optional)
ADMIN_EMAILS=

# Worker: all | builds | provisioning
WORKER_MODE=all
WORKER_ID=
WORKER_POLL_MS=2000
PROVISIONING_LEASE_MINUTES=10

# Local dev: process queued builds + provisioning inside Next.js (or run `npm run worker`)
# Default: enabled in production (set 0 on web app if you run a separate `npm run worker` Liara app)
INLINE_BUILD_WORKER=1

# Liara CLI deploy from your machine (npm run deploy:liara) — not sent to the Next.js app
LIARA_API_TOKEN=
# Or: LIARA_API_KEY=   (same PaaS API token from Liara console)
LIARA_APP_ID=your-next-app-id
LIARA_TEAM_ID=your-team-id
# Optional public URL used when syncing BETTER_AUTH_URL (npm run env:liara)
# LIARA_PUBLIC_URL=https://builder1.liara.run
