# Local / Liara Postgres — see Liara dashboard for host, user, password, db name
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Cursor Cloud Agents (Pro+ / usage limits apply — see Cursor dashboard)
CURSOR_API_KEY=

# GitHub repo Cursor can read/write (push template/ there first — see README)
TEMPLATE_REPO_URL=https://github.com/Alirezaanorouzi/builder-clinic-template
TEMPLATE_REPO_REF=main

# Vercel — platform token for provisioning + deployment polling
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PRODUCTION_URL=

CURSOR_MODEL_ID=

# Per-site GitHub repos from template (repo scope on token)
PLATFORM_GITHUB_TOKEN=
GITHUB_REPO_OWNER=

# Comma-separated emails promoted to admin on login (optional)
ADMIN_EMAILS=

# Worker: all | builds | provisioning
WORKER_MODE=all
WORKER_ID=
WORKER_POLL_MS=2000
PROVISIONING_LEASE_MINUTES=10

# Local dev: process queued builds + provisioning inside Next.js (or run `npm run worker`)
INLINE_BUILD_WORKER=1
