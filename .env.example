# Coding engine: cursor | opencode
CODING_ENGINE=cursor

# Cursor Cloud Agents (Premium+ plan required)
CURSOR_API_KEY=

# GitHub repo Cursor can read/write (push template/ there first — see README)
TEMPLATE_REPO_URL=https://github.com/Alirezaanorouzi/builder-clinic-template

# Branch the agent commits to (connect this repo to Vercel)
TEMPLATE_REPO_REF=main

# Vercel — project `builder-clinic-template` (GitHub plugin / same repo)
# Create token: https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_YXNtMLWeKFFOHW7wP9qIYL1vOQ1G
# Team id (team_… from Team Settings → General), NOT the dashboard slug
VERCEL_TEAM_ID=team_BNUcVJabhzSdiAM18A5IIeu4
# Optional: show this URL if deployment list API is forbidden (same as production site)
VERCEL_PRODUCTION_URL=https://builder-clinic-template.vercel.app

# Optional model id from GET https://api.cursor.com/v1/models
CURSOR_MODEL_ID=

# OpenCode (when CODING_ENGINE=opencode) — run engines/opencode/docker first
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=builder-dev-secret
OPENCODE_MAX_WAIT_MS=900000
# OpenRouter model id (free tier: openrouter/openrouter/free)
OPENCODE_MODEL=openrouter/openrouter/free
