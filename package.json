{
  "name": "builder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "schema": "src/lib/db/schema.prisma"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node build-production.mjs",
    "start": "node start-production.mjs",
    "lint": "next lint",
    "worker": "tsx scripts/build-worker.ts",
    "backfill:preview-gate": "tsx scripts/backfill-preview-gate.ts",
    "probe:gateway": "tsx scripts/probe-gateway.ts",
    "sync:gateway-github": "node scripts/sync-gateway-github.mjs",
    "sync:gateway-github:push": "node scripts/sync-gateway-github.mjs --push",
    "sync:template-github": "node scripts/sync-template-github.mjs",
    "sync:template-github:push": "node scripts/sync-template-github.mjs --push",
    "logs:liara": "node scripts/liara-logs-api.mjs",
    "status:liara": "node scripts/liara-app-status.mjs",
    "deploy:liara": "node scripts/liara-deploy.mjs",
    "env:liara": "node scripts/liara-sync-env.mjs",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:generate": "tsx scripts/prisma-cli.ts generate",
    "db:migrate": "tsx scripts/prisma-cli.ts migrate dev",
    "db:push": "tsx scripts/prisma-cli.ts db push",
    "test:quota": "node scripts/run-quota-tests.mjs"
  },
  "dependencies": {
    "@cursor/sdk": "^1.3.1",
    "@prisma/client": "^6.9.0",
    "better-auth": "^1.2.8",
    "next": "15.5.28",
    "prisma": "^6.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^7.30.2"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "15.5.28"
  },
  "devDependencies": {
    "@liara/cli": "^9.4.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
