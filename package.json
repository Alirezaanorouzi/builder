{
  "name": "builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "worker": "tsx scripts/build-worker.ts",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:generate": "tsx scripts/prisma-cli.ts generate",
    "db:migrate": "tsx scripts/prisma-cli.ts migrate dev",
    "db:push": "tsx scripts/prisma-cli.ts db push"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "better-auth": "^1.2.8",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "15.5.28"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.7",
    "prisma": "^6.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
