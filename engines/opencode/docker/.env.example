TEMPLATE_REPO_URL=https://github.com/Alirezaanorouzi/builder-clinic-template
TEMPLATE_REPO_REF=main
# Same as GITHUB_TOKEN — used only for git clone/push (not exposed to OpenCode as Copilot)
TEMPLATE_REPO_TOKEN=
GITHUB_TOKEN=
OPENCODE_SERVER_PASSWORD=builder-dev-secret
OPENCODE_SERVER_USERNAME=opencode
OPENROUTER_API_KEY=
# Git commit author on push — must match the GitHub user linked to the *Vercel project* that deploys this repo
# (not always the repo owner). Example: if Vercel is under team alis-projects and only commits from
# fatemeno3456@gmail.com deploy, use that email here. Best fix: import the repo on YOUR Vercel team instead.
TEMPLATE_REPO_GIT_NAME=Website Builder
TEMPLATE_REPO_GIT_EMAIL=
